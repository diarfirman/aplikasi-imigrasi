# Elasticsearch Connection
ES_URL=https://your-elasticsearch-url.es.region.aws.found.io

# Autentikasi: gunakan API Key (direkomendasikan)
ES_API_KEY=your_api_key_here

# Atau gunakan username/password sebagai alternatif
# ES_USERNAME=elastic
# ES_PASSWORD=your_password_here

# Flask Configuration
SECRET_KEY=generate-a-random-64-char-string-here
FLASK_DEBUG=False

# OpenTelemetry — kirim traces, metrics, logs ke Elastic Cloud via OTLP
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-deployment.ingest.region.aws.elastic-cloud.com:443
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey your_otel_api_key_here
OTEL_ENVIRONMENT=production
